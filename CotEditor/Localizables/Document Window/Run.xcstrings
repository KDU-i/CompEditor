    "SendHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run sends the initial input unchanged. Each later Send appends one LF. This does not detect whether the program is waiting for input."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行時の入力はそのまま送信します。その後の「送信」では末尾に改行（LF）を1つ追加します。プログラムが入力待ちかどうかは検出しません。"
          }
        }
      }
    },
    "SnapshotInputHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run sends this text as UTF-8, unchanged, then EOF. Empty input sends EOF immediately; no newline is added."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行時の内容を UTF-8 でそのまま送り、EOF で閉じます。空欄なら直ちに EOF を送信し、改行は追加しません。"
          }
        }
      }
    },
