        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このソース内のトップレベルクラスを完全修飾名で指定してください。compact source、module、別ソースや外部ライブラリには対応していません。"
          }
        }
      }
    },
    "MissingRuntime": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime unavailable or invalid. Install Python 3 or select an existing interpreter / complete JDK. An explicit selection is never silently replaced."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランタイムが見つからないか、使用できません。Python 3 をインストールするか、既存のインタープリタ／完全な JDK を選択してください。明示した設定は自動で置き換えません。"
          }
        }
      }
    },
