    "InvalidMain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Specify a fully qualified top-level class from this source. Compact source, modules, other sources and external dependencies are unsupported."
          }
