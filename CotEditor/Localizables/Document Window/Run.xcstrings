    "PythonGuidance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Python 3 is required; Node/Pyright is not an interpreter. Candidates below are checked only in the source directory’s .venv/bin/python, then /opt/homebrew/bin/python3, /usr/local/bin/python3 and /usr/bin/python3, in that order. Select a candidate to inspect its version. Nothing is installed automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Python 3 が必要です。Node／Pyright はインタープリタではありません。候補はソースと同じフォルダの .venv/bin/python、/opt/homebrew/bin/python3、/usr/local/bin/python3、/usr/bin/python3 の順に探します。候補を選ぶとバージョンを確認します。自動インストールは行いません。"
          }
        }
      }
    },
